#!/bin/sh
# Hook pre-commit opcional: escanea los cambios en stage con gitleaks.
# Activar con: git config core.hooksPath .githooks
if command -v gitleaks >/dev/null 2>&1; then
    gitleaks protect --staged --redact -v
    exit $?
fi
echo "pre-commit: gitleaks no esta instalado; se omite el escaneo de secretos." >&2
exit 0
